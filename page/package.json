{
  "name": "link-in-bio-page",
  "private": true,
  "version": "0.0.1",
  "description": "Build tooling and browser tests for the Link in Bio page (the page itself is rendered by the Rust service).",
  "license": "0BSD",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-tokens.mjs && node scripts/build-icons.mjs",
    "check:vendored": "node scripts/sync-tokens.mjs --check && node scripts/build-icons.mjs --check",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test:e2e": "playwright test",
    "shots": "SHOTS=1 playwright test",
    "lhci": "lhci autorun"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.0",
    "@meddleware/design-tokens": "0.1.13",
    "@meddleware/frontend-config": "^0.0.16",
    "@meddleware/ui": "0.1.46",
    "@playwright/test": "~1.64.1",
    "lucide-static": "1.78.0",
    "simple-icons": "16.38.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.4",
    "tmp": "^0.2.7",
    "zod": "^4.6.7"
  },
  "browserslist": [
    "extends @meddleware/frontend-config/browserslist-config"
  ]
}
